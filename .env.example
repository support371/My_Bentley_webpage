# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback/google

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/callback/github

# FastAPI Backend Configuration
DATABASE_URL=sqlite:///./test.db
SECRET_KEY=your_secret_key_here_change_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Bentley iTwin Configuration
BENTLEY_CLIENT_ID=your_bentley_client_id
BENTLEY_CLIENT_SECRET=your_bentley_client_secret
BENTLEY_AUTHORIZATION_URL=https://api.bentley.com/identity/connect/authorize
BENTLEY_TOKEN_URL=https://api.bentley.com/identity/connect/token
BENTLEY_API_BASE_URL=https://api.bentley.com/v1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
DEBUG=True
